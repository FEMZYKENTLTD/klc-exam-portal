<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.femzyk.klc.admin.QuestionEditorController"
      style="-fx-background-color:#f5f7fb;">

	<!-- Page Header -->
	<VBox style="-fx-background-color:#0f1f3c; -fx-padding:16 20; -fx-spacing:4;">
		<Label text="Question Editor - Bulk Subject Editing"
               style="-fx-text-fill:white; -fx-font-size:20px;
                      -fx-font-weight:bold;"/>
		<Label text="Pick a subject and class, load ALL its questions, edit them together, save once"
               style="-fx-text-fill:#94a3b8; -fx-font-size:12px;"/>
	</VBox>

	<VBox spacing="12" style="-fx-padding:16;" VBox.vgrow="ALWAYS">

		<!-- Picker Bar -->
		<HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-background-color:white; -fx-padding:12;
                     -fx-background-radius:10;
                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),8,0,0,2);">
			<VBox spacing="4" HBox.hgrow="ALWAYS">
				<Label text="Subject (type to match or pick from list)"
                       style="-fx-font-weight:bold; -fx-font-size:13px;
                              -fx-text-fill:#0f1f3c;"/>
				<ComboBox fx:id="subjectBox"
                          promptText="Select or type subject name"
                          maxWidth="1.7976931348623157E308"
                          style="-fx-border-color:#c8d3e8; -fx-border-radius:8;"/>
			</VBox>
			<VBox spacing="4">
				<Label text="Class"
                       style="-fx-font-weight:bold; -fx-font-size:13px;
                              -fx-text-fill:#0f1f3c;"/>
				<ComboBox fx:id="classBox"
                          promptText="Class"
                          prefWidth="120"
                          style="-fx-border-color:#c8d3e8; -fx-border-radius:8;"/>
			</VBox>
			<VBox spacing="4" alignment="BOTTOM_LEFT">
				<Label text=" "/>
				<Button fx:id="loadBtn" text="Load Questions"
                        onAction="#loadQuestions"
                        styleClass="btn-primary"
                        style="-fx-padding:9 18;"/>
			</VBox>
			<VBox spacing="4" alignment="BOTTOM_LEFT">
				<Label text=" "/>
				<Button text="New Question"
                        onAction="#newQuestion"
                        style="-fx-background-color:#10b981; -fx-text-fill:white;
                               -fx-font-weight:bold; -fx-background-radius:8;
                               -fx-padding:9 18; -fx-cursor:hand;"/>
			</VBox>
			<VBox spacing="4" alignment="BOTTOM_LEFT">
				<Label text=" "/>
				<Button text="SAVE ALL CHANGES"
                        onAction="#saveAll"
                        style="-fx-background-color:#d4af37; -fx-text-fill:#0f1f3c;
                               -fx-font-weight:bold; -fx-background-radius:8;
                               -fx-padding:9 18; -fx-cursor:hand;"/>
			</VBox>
		</HBox>

		<Label fx:id="status"
               wrapText="true"
               style="-fx-font-size:12px; -fx-font-weight:bold;"/>

		<!-- Split: question list (left) + editor (right) -->
		<SplitPane dividerPositions="0.32" VBox.vgrow="ALWAYS" prefHeight="520">

			<!-- LEFT: all questions in this subject/class -->
			<VBox style="-fx-background-color:white;
                         -fx-border-color:#e2e8f0;
                         -fx-border-radius:10;
                         -fx-background-radius:10;
                         -fx-padding:10;" spacing="6">
				<Label text="Questions in this Subject/Class"
                       style="-fx-font-weight:bold; -fx-font-size:13px;
                              -fx-text-fill:#0f1f3c;"/>
				<Label fx:id="listInfoLabel"
                       text="Load a subject and class to begin."
                       wrapText="true"
                       style="-fx-text-fill:#64748b; -fx-font-size:11px;"/>
				<ListView fx:id="questionList" VBox.vgrow="ALWAYS"
                          style="-fx-border-color:transparent;"/>
			</VBox>

			<!-- RIGHT: editor for the selected question -->
			<ScrollPane fitToWidth="true"
                        style="-fx-background-color:transparent;
                               -fx-background:transparent;">
				<VBox spacing="10" style="-fx-padding:4 0 4 8;">

					<VBox styleClass="card" spacing="10">
						<Label text="Selected Question"
                               style="-fx-font-size:14px; -fx-font-weight:bold;
                                      -fx-text-fill:#0f1f3c;"/>

						<HBox spacing="12">
							<VBox spacing="4">
								<Label text="Difficulty"
                                       style="-fx-font-weight:bold; -fx-font-size:12px;"/>
								<ComboBox fx:id="diffBox" prefWidth="110"
                                          style="-fx-border-color:#c8d3e8;
                                                 -fx-border-radius:8;"/>
							</VBox>
							<VBox spacing="4">
								<Label text="Correct Answer"
                                       style="-fx-font-weight:bold; -fx-font-size:12px;"/>
								<ComboBox fx:id="correctBox" prefWidth="100"
                                          style="-fx-border-color:#c8d3e8;
                                                 -fx-border-radius:8;"/>
							</VBox>
						<VBox spacing="4">
							<Label text="Topic (optional)"
                                       style="-fx-font-weight:bold; -fx-font-size:12px;"/>
							<TextField fx:id="topicField"
                                           promptText="e.g. Quadratic Equations"
                                           style="-fx-border-color:#c8d3e8;
                                                  -fx-border-radius:8;
                                                  -fx-background-radius:8;
                                                  -fx-padding:8;"/>
						</VBox>
						<!-- KLC v1.0 spec 4.3: WAEC/NECO year + Bloom's taxonomy -->
						<VBox spacing="4">
							<Label text="Year"
                                       style="-fx-font-weight:bold; -fx-font-size:12px;"/>
							<TextField fx:id="yearField" prefWidth="80"
                                           promptText="2024"
                                           style="-fx-border-color:#c8d3e8;
                                                  -fx-border-radius:8;
                                                  -fx-background-radius:8;
                                                  -fx-padding:8;"/>
						</VBox>
						<VBox spacing="4">
							<Label text="Bloom's Level"
                                       style="-fx-font-weight:bold; -fx-font-size:12px;"/>
							<ComboBox fx:id="bloomBox" prefWidth="130"
                                          promptText="(optional)"
                                          style="-fx-border-color:#c8d3e8;
                                                 -fx-border-radius:8;"/>
						</VBox>
					</HBox>

						<VBox spacing="4">
							<Label text="Question Text"
                                   style="-fx-font-weight:bold; -fx-font-size:12px;"/>
							<TextArea fx:id="questionText"
                                      promptText="Type the full question here..."
                                      prefRowCount="3"
                                      wrapText="true"
                                      style="-fx-border-color:#c8d3e8;
                                             -fx-border-radius:8;
                                             -fx-background-radius:8;"/>
						</VBox>

						<VBox spacing="4">
							<Label text="Image / Diagram (optional)"
                                   style="-fx-font-weight:bold; -fx-font-size:12px;"/>
							<HBox spacing="8">
								<TextField fx:id="imagePathField"
                                           promptText="Click Attach Image to select a file..."
                                           HBox.hgrow="ALWAYS"
                                           editable="false"
                                           style="-fx-border-color:#c8d3e8;
                                                  -fx-border-radius:8;
                                                  -fx-background-radius:8;
                                                  -fx-padding:8;"/>
								<Button text="Attach Image"
                                        onAction="#chooseImage"
                                        style="-fx-background-color:#3b82f6;
                                               -fx-text-fill:white;
                                               -fx-font-weight:bold;
                                               -fx-background-radius:8;
                                               -fx-padding:8 14; -fx-cursor:hand;"/>
							</HBox>
						</VBox>
					</VBox>

					<VBox styleClass="card" spacing="8">
						<Label text="Answer Options (A required, B required, C-E optional)"
                               style="-fx-font-size:13px; -fx-font-weight:bold;
                                      -fx-text-fill:#0f1f3c;"/>

						<HBox spacing="8" alignment="TOP_LEFT">
							<Label text="A" style="-fx-font-weight:bold; -fx-font-size:16px;
                                   -fx-min-width:20; -fx-padding:6 0 0 0;"/>
							<TextArea fx:id="optA" promptText="Option A text..."
                                      prefRowCount="1" wrapText="true" HBox.hgrow="ALWAYS"
                                      style="-fx-border-color:#c8d3e8; -fx-border-radius:8;
                                             -fx-background-radius:8;"/>
						</HBox>
						<HBox spacing="8" alignment="TOP_LEFT">
							<Label text="B" style="-fx-font-weight:bold; -fx-font-size:16px;
                                   -fx-min-width:20; -fx-padding:6 0 0 0;"/>
							<TextArea fx:id="optB" promptText="Option B text..."
                                      prefRowCount="1" wrapText="true" HBox.hgrow="ALWAYS"
                                      style="-fx-border-color:#c8d3e8; -fx-border-radius:8;
                                             -fx-background-radius:8;"/>
						</HBox>
						<HBox spacing="8" alignment="TOP_LEFT">
							<Label text="C" style="-fx-font-weight:bold; -fx-font-size:16px;
                                   -fx-min-width:20; -fx-padding:6 0 0 0;"/>
							<TextArea fx:id="optC" promptText="Option C text..."
                                      prefRowCount="1" wrapText="true" HBox.hgrow="ALWAYS"
                                      style="-fx-border-color:#c8d3e8; -fx-border-radius:8;
                                             -fx-background-radius:8;"/>
						</HBox>
						<HBox spacing="8" alignment="TOP_LEFT">
							<Label text="D" style="-fx-font-weight:bold; -fx-font-size:16px;
                                   -fx-min-width:20; -fx-padding:6 0 0 0;"/>
							<TextArea fx:id="optD" promptText="Option D text..."
                                      prefRowCount="1" wrapText="true" HBox.hgrow="ALWAYS"
                                      style="-fx-border-color:#c8d3e8; -fx-border-radius:8;
                                             -fx-background-radius:8;"/>
						</HBox>
						<HBox spacing="8" alignment="TOP_LEFT">
							<Label text="E" style="-fx-font-weight:bold; -fx-font-size:16px;
                                   -fx-text-fill:#94a3b8; -fx-min-width:20;
                                   -fx-padding:6 0 0 0;"/>
							<TextArea fx:id="optE"
                                      promptText="Option E (optional)"
                                      prefRowCount="1" wrapText="true" HBox.hgrow="ALWAYS"
                                      style="-fx-border-color:#e2e8f0; -fx-border-radius:8;
                                             -fx-background-radius:8;"/>
						</HBox>
					</VBox>

					<VBox styleClass="card" spacing="6">
						<Label text="Explanation / Solution (optional)"
                               style="-fx-font-size:13px; -fx-font-weight:bold;
                                      -fx-text-fill:#0f1f3c;"/>
						<TextArea fx:id="explanationText"
                                  prefRowCount="2"
                                  wrapText="true"
                                  promptText="Shown to students in post-exam review if enabled..."
                                  style="-fx-border-color:#c8d3e8; -fx-border-radius:8;
                                         -fx-background-radius:8;"/>
						<Label text="Changes are kept as you click between questions. Nothing is written to the database until you press SAVE ALL CHANGES. New questions are PENDING approval."
                               wrapText="true"
                               style="-fx-text-fill:#667085; -fx-font-size:11px;"/>
					</VBox>

				</VBox>
			</ScrollPane>

		</SplitPane>

	</VBox>
</VBox>
