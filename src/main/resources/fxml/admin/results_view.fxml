<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.femzyk.klc.admin.ResultsViewController"
      style="-fx-background-color:#f5f7fb;">

	<!-- ══ Page Header ══ -->
	<VBox style="-fx-background-color:#0f1f3c; -fx-padding:16 20; -fx-spacing:4;">
		<Label text="Results and Reports"
               style="-fx-text-fill:white; -fx-font-size:20px;
                      -fx-font-weight:bold;"/>
		<Label text="View student results, export report cards and send notifications"
               style="-fx-text-fill:#94a3b8; -fx-font-size:12px;"/>
	</VBox>

	<VBox spacing="12" style="-fx-padding:16;" VBox.vgrow="ALWAYS">

		<!-- ══ Toolbar ══ -->
		<HBox spacing="8" alignment="CENTER_LEFT"
              style="-fx-background-color:white;
                     -fx-padding:12;
                     -fx-background-radius:10;
                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),8,0,0,2);">

			<!-- Search -->
			<VBox spacing="3">
				<Label text="Search Student"
                       style="-fx-font-size:11px; -fx-font-weight:bold;
                              -fx-text-fill:#64748b;"/>
				<TextField fx:id="searchField"
                           promptText="Type student name or subject..."
                           prefWidth="240"
                           style="-fx-border-color:#c8d3e8;
                                  -fx-border-radius:8;
                                  -fx-background-radius:8;
                                  -fx-padding:8 10;
                                  -fx-font-size:13px;
                                  -fx-prompt-text-fill:#94a3b8;"/>
			</VBox>

			<!-- Term Filter -->
			<VBox spacing="3">
				<Label text="Term"
                       style="-fx-font-size:11px; -fx-font-weight:bold;
                              -fx-text-fill:#64748b;"/>
				<ComboBox fx:id="termBox"
                          promptText="All Terms"
                          prefWidth="120"
                          style="-fx-border-color:#c8d3e8;
                                 -fx-border-radius:8;
                                 -fx-padding:4;"/>
			</VBox>

			<Region HBox.hgrow="ALWAYS"/>

			<!-- Action Buttons -->
			<Button text="Refresh"
                    onAction="#loadResults"
                    style="-fx-background-color:#eaf0fb;
                           -fx-border-color:#c8d3e8;
                           -fx-border-radius:8;
                           -fx-background-radius:8;
                           -fx-padding:9 16;
                           -fx-cursor:hand;
                           -fx-font-size:13px;"/>

			<Button text="Report Card PDF"
                    onAction="#exportReportCard"
                    style="-fx-background-color:#0f1f3c;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;
                           -fx-background-radius:8;
                           -fx-padding:9 16;
                           -fx-cursor:hand;
                           -fx-font-size:13px;"/>

			<Button text="Transcript JSS1-SS3"
                    onAction="#exportTranscript"
                    style="-fx-background-color:#8b5cf6;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;
                           -fx-background-radius:8;
                           -fx-padding:9 16;
                           -fx-cursor:hand;
                           -fx-font-size:13px;"/>

			<Button text="Graduation Cert"
                    onAction="#exportGraduation"
                    style="-fx-background-color:#d4af37;
                           -fx-text-fill:#0f1f3c;
                           -fx-font-weight:bold;
                           -fx-background-radius:8;
                           -fx-padding:9 16;
                           -fx-cursor:hand;
                           -fx-font-size:13px;"/>

			<Button text="Notify Parent"
                    onAction="#notifyResult"
                    style="-fx-background-color:#10b981;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;
                           -fx-background-radius:8;
                           -fx-padding:9 16;
                           -fx-cursor:hand;
                           -fx-font-size:13px;"/>
		</HBox>

		<!-- ══ Status Label ══ -->
		<Label fx:id="status"
               wrapText="true"
               style="-fx-font-size:13px; -fx-font-weight:bold;
                      -fx-text-fill:#0f7a3a;"/>

		<!-- ══ Results Table ══ -->
		<TableView fx:id="table"
                   VBox.vgrow="ALWAYS"
                   style="-fx-background-radius:10;
                          -fx-border-color:#e2e8f0;
                          -fx-border-radius:10;"
                   prefHeight="480">
			<columns>
				<TableColumn fx:id="colName"
                             text="Student Name"
                             prefWidth="210"/>
				<TableColumn fx:id="colAdm"
                             text="Admission No"
                             prefWidth="120"/>
				<TableColumn fx:id="colSubject"
                             text="Subject"
                             prefWidth="150"/>
				<TableColumn fx:id="colScore"
                             text="Score"
                             prefWidth="90"/>
				<TableColumn fx:id="colGrade"
                             text="Grade"
                             prefWidth="80"/>
				<TableColumn fx:id="colPos"
                             text="Position"
                             prefWidth="80"/>
				<TableColumn fx:id="colDate"
                             text="Date"
                             prefWidth="110"/>
			</columns>
			<placeholder>
				<Label text="No results yet. Results appear after students complete exams."
                       style="-fx-text-fill:#94a3b8; -fx-font-size:14px;"/>
			</placeholder>
		</TableView>

		<!-- ══ Footer Info ══ -->
		<Label wrapText="true"
               style="-fx-text-fill:#667085; -fx-font-size:11px;
                      -fx-padding:4 0;"
               text="Report Card: School Logo + Student Passport Photo + Principal Signature (OLUFEMI BENUA KERIPE) + QR Verification. NO FEMZYK watermark on official documents. Transcript: Cumulative JSS1 to SS3 with CGPA. Graduation Certificate: SS3 completers only. Notify: Email via SMTP + SMS via Termii Nigeria. Result PIN = SURNAME + CLASS e.g. KERIPESS2"/>

	</VBox>
</VBox>