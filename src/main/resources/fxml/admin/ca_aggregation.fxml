<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14" styleClass="screen-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.femzyk.klc.admin.CaScoreController" style="-fx-padding:24">
    <Label text="CA Aggregation &amp; Positions" style="-fx-font-size:20px; -fx-font-weight:bold"/>
    <Label text="Import CA1/CA2 (CSV: admission_no, ca1, ca2), then aggregate CBT exam scores into Total, Grade and tie-aware class Position using the configured grading scale."
           style="-fx-text-fill:#64748b" wrapText="true"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Subject"/><ComboBox fx:id="subjectBox" promptText="Subject"/>
        <Label text="Class"/><ComboBox fx:id="classBox" promptText="Class"/>
        <Label text="Term"/><ComboBox fx:id="termBox" promptText="Term"/>
        <Button text="Load Scores" onAction="#loadScores"/>
        <Button text="Import CA CSV" onAction="#importCaCsv"/>
        <Button text="Aggregate Exam Scores" onAction="#aggregateExam"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colAdm" text="Admission No" prefWidth="130"/>
            <TableColumn fx:id="colName" text="Student" prefWidth="220"/>
            <TableColumn fx:id="colCa1" text="CA1" prefWidth="80"/>
            <TableColumn fx:id="colCa2" text="CA2" prefWidth="80"/>
            <TableColumn fx:id="colExam" text="Exam" prefWidth="80"/>
            <TableColumn fx:id="colTotal" text="Total" prefWidth="80"/>
            <TableColumn fx:id="colGrade" text="Grade" prefWidth="80"/>
        </columns>
    </TableView>
    <Label fx:id="status" wrapText="true"/>
</VBox>
