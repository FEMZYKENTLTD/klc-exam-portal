<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.femzyk.klc.admin.IdCardController"
      style="-fx-background-color:#f5f7fb;">

	<!-- Header -->
	<VBox style="-fx-background-color:#0f1f3c; -fx-padding:16 20; -fx-spacing:4;">
		<Label text="Student ID Card Generator"
               style="-fx-text-fill:white; -fx-font-size:20px;
                      -fx-font-weight:bold;"/>
		<Label text="Generate individual or bulk student ID cards with QR code"
               style="-fx-text-fill:#94a3b8; -fx-font-size:12px;"/>
	</VBox>

	<VBox spacing="12" style="-fx-padding:16;">

		<!-- Toolbar -->
		<HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-background-color:white; -fx-padding:12;
                     -fx-background-radius:10;
                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),8,0,0,2);">

			<VBox spacing="3">
				<Label text="Filter by Class"
                       style="-fx-font-size:11px; -fx-font-weight:bold;
                              -fx-text-fill:#64748b;"/>
				<ComboBox fx:id="classFilter"
                          prefWidth="140"
                          style="-fx-border-color:#c8d3e8; -fx-border-radius:8;"/>
			</VBox>

			<Button text="Refresh List"
                    onAction="#load"
                    style="-fx-background-color:#eaf0fb; -fx-border-color:#c8d3e8;
                           -fx-border-radius:8; -fx-background-radius:8;
                           -fx-padding:9 14; -fx-cursor:hand;
                           -fx-margin:16 0 0 0;"/>

			<Region HBox.hgrow="ALWAYS"/>

			<Button text="Generate Selected"
                    onAction="#generateSelected"
                    styleClass="btn-primary"
                    style="-fx-padding:9 16;"/>
			<Button text="Generate All (Bulk)"
                    onAction="#generateBulk"
                    style="-fx-background-color:#d4af37; -fx-text-fill:#0f1f3c;
                           -fx-font-weight:bold; -fx-background-radius:8;
                           -fx-padding:9 14; -fx-cursor:hand;"/>
			<Label fx:id="status"
                   style="-fx-font-size:12px; -fx-text-fill:#64748b;"/>
		</HBox>

		<!-- Table -->
		<TableView fx:id="table" VBox.vgrow="ALWAYS" prefHeight="480"
                   style="-fx-background-radius:10; -fx-border-color:#e2e8f0;
                          -fx-border-radius:10;">
			<columns>
				<TableColumn fx:id="colAdm"   text="Admission No" prefWidth="140"/>
				<TableColumn fx:id="colName"  text="Full Name"    prefWidth="240"/>
				<TableColumn fx:id="colClass" text="Class"        prefWidth="100"/>
			</columns>
			<placeholder>
				<Label text="No active students found."
                       style="-fx-text-fill:#94a3b8; -fx-font-size:14px;"/>
			</placeholder>
		</TableView>

		<Label text="ID Cards include: Student Photo, Name, Admission No, Class, Session, QR Code for verification. PDF saved to app folder. Upload passport photos via Student Manager."
               wrapText="true"
               style="-fx-text-fill:#667085; -fx-font-size:11px;"/>
	</VBox>
</VBox>