<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14" styleClass="screen-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.femzyk.klc.admin.ReportCardGeneratorController" style="-fx-padding:24" maxWidth="640">
    <Label text="Report Card &amp; Transcript Generator" style="-fx-font-size:20px; -fx-font-weight:bold"/>
    <Label text="Generate the official KLC term report card or the cumulative JSS1-SS3 transcript for one student. Official documents carry no vendor watermark."
           style="-fx-text-fill:#64748b" wrapText="true"/>
    <GridPane hgap="10" vgap="12">
        <Label text="Admission Number" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="admissionField" promptText="e.g. KLC/SS2/045" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Term" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="termBox" promptText="Term" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Session" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="sessionBox" promptText="Session" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="Generate Report Card" onAction="#generateReportCard"/>
        <Button text="Generate Transcript" onAction="#generateTranscript"/>
    </HBox>
    <Label fx:id="statusLabel" wrapText="true"/>
</VBox>
