<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="12" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.femzyk.klc.admin.TwoFaController" style="-fx-padding:18;" alignment="CENTER">
  <Label text="🔐 Two-Factor Authentication – TOTP" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
  <Label text="Recommended for all Admin / Teacher / Exam Officer accounts" styleClass="small-muted"/>
  <ImageView fx:id="qrImageView" fitWidth="200" fitHeight="200" preserveRatio="true"/>
  <Label fx:id="secretLabel" style="-fx-font-family: 'Consolas', monospace; -fx-font-size:11px;" wrapText="true"/>
  <HBox spacing="8" alignment="CENTER">
    <TextField fx:id="codeField" promptText="6-digit code" prefWidth="140"/>
    <CheckBox fx:id="enableCheck" text="Enable 2FA"/>
    <Button text="Verify &amp; Save" onAction="#verifyAndToggle" styleClass="btn-primary"/>
  </HBox>
  <Label fx:id="statusLabel" textFill="#0f7a3a" wrapText="true"/>
  <Label text="1. Install Google Authenticator / Authy on your phone&#10;2. Scan QR code&#10;3. Enter 6-digit code → Enable&#10;4. Next login will ask for code&#10;&#10;If you lose your phone: Contact Super Admin OLUFEMI BENUA KERIPE to reset" styleClass="small-muted"/>
</VBox>
