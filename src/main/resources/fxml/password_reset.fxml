<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.femzyk.klc.auth.PasswordResetController"
      styleClass="root" prefWidth="1150" prefHeight="720">

	<!-- Header -->
	<VBox alignment="CENTER" styleClass="header"
          maxWidth="1.7976931348623157E308">
		<Label text="KNOWLEDGE LAND COLLEGE"
               styleClass="header-title"/>
		<Label text="CBT SUITE v1.0 - Password Reset"
               style="-fx-text-fill:white; -fx-font-size:13px;"/>
	</VBox>

	<VBox styleClass="card" maxWidth="480" spacing="14"
          style="-fx-padding:28;">

		<Label text="Reset Password"
               style="-fx-font-size:20px; -fx-font-weight:bold;
                      -fx-text-fill:#0f1f3c;"/>
		<Label text="Enter your email to retrieve your security question."
               style="-fx-text-fill:#64748b; -fx-font-size:13px;"
               wrapText="true"/>

		<!-- Step 1: Find Account -->
		<VBox fx:id="step1Box" spacing="12">
			<VBox spacing="4">
				<Label text="Email Address"
                       style="-fx-font-weight:bold; -fx-font-size:13px;
                              -fx-text-fill:#0f1f3c;"/>
				<TextField fx:id="emailField"
                           promptText="Enter your registered email address"
                           style="-fx-border-color:#c8d3e8; -fx-border-radius:8;
                                  -fx-background-radius:8; -fx-padding:9;
                                  -fx-font-size:14px;
                                  -fx-prompt-text-fill:#64748b;"/>
			</VBox>
			<Button text="Find My Account"
                    onAction="#findAccount"
                    styleClass="btn-primary"
                    maxWidth="1.7976931348623157E308"
                    style="-fx-font-size:14px; -fx-padding:11 0;"/>
		</VBox>

		<!-- Step 2: Answer Security Question + New Password -->
		<VBox fx:id="step2Box" spacing="12"
              visible="false" managed="false">

			<Label fx:id="questionLabel"
                   text="Security Question:"
                   style="-fx-font-weight:bold; -fx-font-size:13px;
                          -fx-text-fill:#0f1f3c;"
                   wrapText="true"/>

			<VBox spacing="4">
				<Label text="Your Answer"
                       style="-fx-font-weight:bold; -fx-font-size:13px;
                              -fx-text-fill:#0f1f3c;"/>
				<TextField fx:id="answerField"
                           promptText="Type your security answer (not case-sensitive)"
                           style="-fx-border-color:#c8d3e8; -fx-border-radius:8;
                                  -fx-background-radius:8; -fx-padding:9;
                                  -fx-font-size:14px;
                                  -fx-prompt-text-fill:#64748b;"/>
			</VBox>

			<VBox spacing="4">
				<Label text="New Password"
                       style="-fx-font-weight:bold; -fx-font-size:13px;
                              -fx-text-fill:#0f1f3c;"/>
				<PasswordField fx:id="newPassField"
                               promptText="Enter new password (minimum 6 characters)"
                               style="-fx-border-color:#c8d3e8; -fx-border-radius:8;
                                      -fx-background-radius:8; -fx-padding:9;
                                      -fx-font-size:14px;
                                      -fx-prompt-text-fill:#64748b;"/>
			</VBox>

			<Button text="Reset My Password"
                    onAction="#doReset"
                    styleClass="btn-primary"
                    maxWidth="1.7976931348623157E308"
                    style="-fx-font-size:14px; -fx-padding:11 0;"/>
		</VBox>

		<!-- Status -->
		<Label fx:id="statusLabel"
               wrapText="true"
               style="-fx-font-size:13px; -fx-font-weight:bold;
                      -fx-text-fill:#c0392b;"/>

		<Separator/>

		<Hyperlink text="Back to Login" onAction="#backLogin"
                   style="-fx-font-size:13px;"/>

		<Label text="If you did not set a security question, contact the Super Admin: OLUFEMI BENUA KERIPE"
               wrapText="true"
               style="-fx-text-fill:#667085; -fx-font-size:12px;"/>
	</VBox>
</VBox>