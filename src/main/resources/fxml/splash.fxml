           style="-fx-background-color:linear-gradient(to bottom right,#0f1f3c,#1b2f5a);">

	<VBox alignment="CENTER" spacing="10">
		<Label text="KNOWLEDGE LAND COLLEGE"
               style="-fx-text-fill:white; -fx-font-size:28px;
